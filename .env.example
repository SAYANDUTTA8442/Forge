# ---- Local Ollama (the default) ----
FORGE_BASE_URL=http://localhost:11434/v1
FORGE_API_KEY=ollama
FORGE_MODEL=llama3.2:3b

# ---- Hosted OpenAI-compatible API example ----
# FORGE_BASE_URL=https://api.openai.com/v1
# FORGE_API_KEY=your-real-key
# FORGE_MODEL=your-tool-capable-model

# ---- Agent behaviour (all optional) ----
FORGE_MAX_STEPS=20                 # model calls per task (1-100); the last one is a no-tools wrap-up
FORGE_COMMAND_TIMEOUT_MS=60000     # per run_command
FORGE_PROVIDER_TIMEOUT_MS=120000   # per model request (local models can be slow on first load)
FORGE_MAX_RETRIES=3                # retries for network errors, HTTP 408/429/5xx (exponential backoff)
FORGE_MAX_OUTPUT_CHARS=20000       # per stream; head and tail are kept
FORGE_MAX_CONTEXT_CHARS=40000      # older tool output is elided beyond this (keep below your model's context)
FORGE_SHELL=auto                   # Windows: auto|powershell|pwsh|cmd   Linux/macOS: auto|sh|bash|zsh|pwsh
FORGE_APPROVAL=ask                 # ask = prompt for sensitive actions; deny = refuse them
